+        ForgeServer server = new ForgeServer();
+        LanServerSettingsApplier.applyOnlineMode(server, false);
+        assertFalse(server.value);
+    }
+
+    @Test void nativePublishOnlineModeRefusesMissingServerOrMissingSetter() {
